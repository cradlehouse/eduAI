{
  "input_schema": {
    "type": "object",
    "required": [
      "prompt"
    ],
    "properties": {
      "prompt": {
        "type": "string",
        "maxLength": 2000,
        "x-ui": {
          "widget": "textarea"
        }
      },
      "duration_s": {
        "type": "integer",
        "enum": [
          6,
          8,
          10
        ],
        "default": 6
      },
      "aspect_ratio": {
        "type": "string",
        "enum": [
          "16:9",
          "9:16"
        ],
        "default": "16:9"
      },
      "resolution": {
        "type": "string",
        "enum": [
          "720p",
          "1080p"
        ],
        "default": "720p"
      },
      "camera_motion": {
        "type": "string",
        "enum": [
          "static",
          "dolly_in",
          "dolly_out",
          "dolly_left",
          "dolly_right",
          "jib_up",
          "jib_down",
          "focus_shift"
        ],
        "x-ui": {
          "widget": "camera-motion"
        }
      },
      "generate_audio": {
        "type": "boolean",
        "default": false
      }
    }
  },
  "safety": {
    "output_moderation": false,
    "prompt_gate": "required"
  }
}