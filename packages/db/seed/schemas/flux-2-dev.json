{ "input_schema": { "type": "object", "required": ["prompt"], "properties": {
    "prompt": { "type": "string", "maxLength": 2000, "x-ui": { "widget": "textarea" } },
    "aspect_ratio": { "type": "string", "enum": ["16:9", "9:16", "1:1", "4:3", "3:4"], "default": "16:9" },
    "num_images": { "type": "integer", "minimum": 1, "maximum": 4, "default": 1 },
    "seed": { "type": "integer", "minimum": 0 } } },
  "safety": { "output_moderation": true, "prompt_gate": "required" } }
