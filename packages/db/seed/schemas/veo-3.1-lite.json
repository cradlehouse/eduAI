{ "input_schema": { "type": "object", "required": ["prompt"], "properties": {
    "prompt": { "type": "string", "maxLength": 2000, "x-ui": { "widget": "textarea" } },
    "duration_s": { "type": "integer", "enum": [4, 6, 8], "default": 6 },
    "aspect_ratio": { "type": "string", "enum": ["16:9", "9:16"], "default": "16:9" },
    "resolution": { "type": "string", "enum": ["720p", "1080p"], "default": "720p" },
    "generate_audio": { "type": "boolean", "default": false } } },
  "safety": { "output_moderation": true, "prompt_gate": "required" } }
